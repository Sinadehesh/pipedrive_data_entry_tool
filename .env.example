# Postgres (Neon / Supabase / RDS)
DATABASE_URL=postgres://user:pass@host:5432/crm_intelligence

# Claap
CLAAP_API_KEY=
CLAAP_WEBHOOK_SECRET=

# Pipedrive
PIPEDRIVE_DOMAIN=yourcompany            # {domain}.pipedrive.com
PIPEDRIVE_API_TOKEN=
# Custom deal field keys (Settings > Data fields > Deal). Leave blank to skip that field.
PIPEDRIVE_FIELD_BANT_BUDGET=
PIPEDRIVE_FIELD_BANT_AUTHORITY=
PIPEDRIVE_FIELD_BANT_NEED=
PIPEDRIVE_FIELD_BANT_TIMELINE=

# Anthropic (Vercel AI SDK provider)
ANTHROPIC_API_KEY=

# Google Workspace ingestion (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic Gmail publishes to: projects/{project}/topics/{topic}
GMAIL_PUBSUB_TOPIC=
# Service account email the Pub/Sub push subscription authenticates as
PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push@your-project.iam.gserviceaccount.com
# Audience configured on the push subscription's OIDC token (usually the
# webhook URL, e.g. https://yourapp.vercel.app/api/webhooks/google/gmail)
PUBSUB_PUSH_AUDIENCE=
# 32 random bytes, base64 — encrypts OAuth refresh tokens at rest:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Inngest (blank in local dev; set in Vercel for production)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Comma-separated domains of YOUR company; participants on these domains are
# never treated as prospects during identity resolution.
INTERNAL_EMAIL_DOMAINS=yourcompany.com
