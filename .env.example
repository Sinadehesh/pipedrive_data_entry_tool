# ============================================================================
# Platform-level configuration ONLY.
# Tenant credentials (Pipedrive tokens, Claap keys, Google refresh tokens),
# field mappings, and internal domains live in the database, encrypted.
# ============================================================================

# Postgres (Neon / Supabase / RDS) — owner role (migrations + pipeline)
DATABASE_URL=postgres://user:pass@host:5432/crm_intelligence
# Same database, non-owner role for RLS-enforced request-path queries.
# LEAVE EMPTY for local dev (falls back to DATABASE_URL). Production MUST
# set it — create the role with scripts/sql/create-rls-role.sql, e.g.
#   postgres://app_rls:<password>@<same-host>:5432/<same-db>
DATABASE_URL_RLS=

# Extraction LLM — anthropic (default) | kimi | deepseek. Only the key for
# the chosen provider is needed. LLM_MODEL optionally overrides the
# provider's default model. See src/lib/ai/model.ts.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# Our Google OAuth app — one app serves all tenants
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic Gmail publishes to (shared across tenants):
#   projects/{project}/topics/{topic}
GMAIL_PUBSUB_TOPIC=
# Service account the push subscription authenticates as
PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push@your-project.iam.gserviceaccount.com
# Audience on the push subscription's OIDC token (usually the webhook URL)
PUBSUB_PUSH_AUDIENCE=

# 32 random bytes, base64 — encrypts tenant credentials at rest:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Auth.js session signing: openssl rand -base64 32
AUTH_SECRET=

# Our Pipedrive Marketplace OAuth app — one app serves all tenants
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# Public origin of this deployment (builds OAuth redirect URIs)
APP_URL=http://localhost:3000

# Inngest (blank in local dev; set in Vercel for production)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local testing only (guide Track A): lets the dev Claap stub serve
# transcripts so no Claap workspace is needed. NEVER set in production.
ALLOW_DEV_STUBS=
CLAAP_API_BASE=
